<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MyAssets/UI/HighScore.uss?fileID=7433441132597879392&amp;guid=703ad2ad25bd64d448178135ecc77e09&amp;type=3#HighScore"/>
    <ui:VisualElement name="root" picking-mode="Ignore" style="-unity-background-image-tint-color: rgb(0, 0, 0); background-color: rgb(0, 0, 0); -unity-font-definition: url(&quot;project://database/Assets/MyAssets/Fonts/mania.ttf?fileID=12800000&amp;guid=38c45d44ba86a014eb54a2f36a8e06df&amp;type=3#mania&quot;); background-repeat: no-repeat no-repeat; background-image: none;">
        <ui:VisualElement name="main-panel" picking-mode="Ignore" style="background-color: rgba(36, 35, 35, 0.5); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px; border-left-color: rgba(86, 85, 85, 0.72); border-right-color: rgba(86, 85, 85, 0.72); border-top-color: rgba(86, 85, 85, 0.72); border-bottom-color: rgba(86, 85, 85, 0.72); width: 80%; height: 80%;">
            <ui:Label text="LEADERBOARD" name="title" style="font-size: 100px;"/>
            <ui:Label text="ONLY THE FASTEST REACTIONS SURVIVE" name="subtitle" style="font-size: 25px;"/>
            <ui:VisualElement name="leaderbord" style="flex-grow: 1; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-left-color: rgb(99, 91, 91); border-right-color: rgb(99, 91, 91); border-top-color: rgb(99, 91, 91); border-bottom-color: rgb(99, 91, 91); background-color: rgb(24, 22, 22); width: 95%; height: 80%; align-self: center; align-items: stretch; justify-content: center; font-size: 30px; -unity-text-auto-size: best-fit 10px 16px;">
                <ui:VisualElement name="table-header" style="width: 95%; align-content: center; align-self: center;">
                    <ui:Label text="RANK" class="header-rank" style="margin-left: 5px; width: 20%;"/>
                    <ui:Label text="PLAYER" class="header-player" style="padding-right: 2px; align-items: center; justify-content: flex-end; align-self: auto; align-content: auto; width: 65%;"/>
                    <ui:Label text="SCORE" class="header-score"/>
                </ui:VisualElement>
                <ui:VisualElement name="entries" style="align-items: auto; justify-content: flex-start; align-self: center; flex-direction: column; align-content: auto; width: 95%;">
                    <ui:VisualElement name="entry-1" class="entry-row" style="margin-top: 0; margin-right: 0%; margin-bottom: 0; margin-left: auto; justify-content: space-between; align-self: center; align-content: center; align-items: auto; width: 100%;">
                        <ui:Label text="1" class="rank" style="width: 20%;"/>
                        <ui:Label text="PLAYER" enable-rich-text="true" class="player" style="flex-basis: auto; flex-wrap: nowrap; align-items: auto; width: 65%;"/>
                        <ui:Label text="000000" class="score" style="width: 100%;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="entry-2" class="entry-row" style="justify-content: flex-start; align-self: center; width: 100%;">
                        <ui:Label text="2" class="rank" style="width: 20%;"/>
                        <ui:Label text="PLAYER" class="player" style="width: 65%;"/>
                        <ui:Label text="000000" class="score"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="entry-3" class="entry-row" style="align-self: center; width: 100%;">
                        <ui:Label text="3" class="rank" style="width: 20%;"/>
                        <ui:Label text="PLAYER" class="player" style="width: 65%;"/>
                        <ui:Label text="000000" class="score"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="entry-4" class="entry-row" style="align-self: center; width: 100%;">
                        <ui:Label text="4" class="rank" style="width: 20%;"/>
                        <ui:Label text="PLAYER" class="player"/>
                        <ui:Label text="000000" class="score"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="entry-5" class="entry-row" style="align-self: center; width: 100%;">
                        <ui:Label text="5" class="rank" style="width: 20%;"/>
                        <ui:Label text="PLAYER" class="player"/>
                        <ui:Label text="000000" class="score"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="entry-6" class="entry-row" style="align-content: auto; align-self: center; width: 100%;">
                        <ui:Label text="6" class="rank" style="width: 20%;"/>
                        <ui:Label text="PLAYER" class="player"/>
                        <ui:Label text="000000" class="score"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="entry-7" class="entry-row" style="justify-content: flex-start; align-content: auto; align-items: flex-end; align-self: center; width: 100%;">
                        <ui:Label text="7" class="rank" style="width: 20%;"/>
                        <ui:Label text="PLAYER" class="player"/>
                        <ui:Label text="000000" class="score"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="entry-8" class="entry-row" style="align-content: auto; align-self: center; width: 100%;">
                        <ui:Label text="8" class="rank" style="width: 20%;"/>
                        <ui:Label text="PLAYER" class="player"/>
                        <ui:Label text="000000" class="score"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="entry-9" class="entry-row" style="align-self: center; width: 100%;">
                        <ui:Label text="9" class="rank" style="width: 20%;"/>
                        <ui:Label text="PLAYER" class="player"/>
                        <ui:Label text="000000" class="score"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="entry-10" class="entry-row" style="align-content: auto; align-self: center; width: 100%;">
                        <ui:Label text="10" class="rank" style="width: 20%;"/>
                        <ui:Label text="PLAYER" class="player"/>
                        <ui:Label text="000000" class="score"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="bottom-panel" style="justify-content: space-around; align-self: auto; align-content: center;">
                <ui:Button text="BACK" name="back-button" style="width: 15%; height: 100%; color: rgb(255, 255, 255); background-color: rgba(49, 48, 48, 0.68); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
                <ui:VisualElement name="best-score-panel" style="background-color: rgba(32, 32, 32, 0.62); border-left-color: rgb(88, 88, 88); border-right-color: rgb(88, 88, 88); border-top-color: rgb(88, 88, 88); border-bottom-color: rgb(88, 88, 88); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; width: 20%; height: 120%;">
                    <ui:Label text="YOUR BEST:" style="font-size: 20px; color: rgb(255, 255, 255);"/>
                    <ui:Label text="000000" name="best-score-value" style="font-size: 50px;"/>
                </ui:VisualElement>
                <ui:Button text="PLAY AGAIN" name="play-button" style="border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-color: rgba(36, 36, 36, 0.56); color: rgb(255, 255, 255); width: 15%; height: 100%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
